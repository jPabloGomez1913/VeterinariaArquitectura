@model VeterinariaArquitectura.ViewModels.Mascota.MascotaDTO

@{
    ViewData["Title"] = "Registrar mascota";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 form-panel">
            <div class="page-heading text-center">
                <h1>Registrar mascota</h1>
                <p>Agrega los datos de la mascota y su persona responsable.</p>
            </div>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["Mensaje"]
                </div>
            }

            <form asp-action="RegistrarMascota" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre de la mascota</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre de la mascota" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="NombrePropietario" class="form-label">Nombre del propietario</label>
                    <input asp-for="NombrePropietario" class="form-control" placeholder="Ingrese el nombre del propietario" />
                    <span asp-validation-for="NombrePropietario" class="text-danger"></span>
                </div>

                 <div class="mb-3">
                    <label asp-for="Especie" class="form-label">Especie</label>
                    <input asp-for="Especie" class="form-control" placeholder="Ingrese la especie de la mascota" />
                    <span asp-validation-for="Especie" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Raza" class="form-label">Raza</label>
                    <input asp-for="Raza" class="form-control" placeholder="Ingrese la raza de la mascota" />
                    <span asp-validation-for="Raza" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Sexo" class="form-label">Sexo</label>
                    <input asp-for="Sexo" class="form-control" placeholder="Ingrese el sexo de la mascota" />
                    <span asp-validation-for="Sexo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Color" class="form-label">Color</label>
                    <input asp-for="Color" class="form-control" placeholder="Ingrese el color de la mascota" />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Peso" class="form-label">Peso</label>
                    <input asp-for="Peso" class="form-control" placeholder="Ingrese el peso de la mascota" />
                    <span asp-validation-for="Peso" class="text-danger"></span>
                </div>


                <button type="submit" class="btn btn-primary w-100">Registrar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
