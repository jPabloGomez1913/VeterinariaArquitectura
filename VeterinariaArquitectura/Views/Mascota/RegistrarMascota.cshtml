@model VeterinariaArquitectura.ViewModels.Mascota.MascotaVM

@{
    ViewData["Title"] = "Registrar mascota";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 form-panel">
            <div class="page-heading text-center">
                <h1>Registrar mascota</h1>
                <p>Agrega los datos de la mascota y su persona responsable.</p>
            </div>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["Mensaje"]
                </div>
            }

            <form asp-action="RegistrarMascota" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre de la mascota</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre de la mascota" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>

                <h2 class="form-section-title">Datos del propietario</h2>

                <div class="mb-3">
                    <label asp-for="NombrePropietario" class="form-label">Nombre del propietario</label>
                    <input asp-for="NombrePropietario" class="form-control" placeholder="Ingrese el nombre del propietario" />
                    <span asp-validation-for="NombrePropietario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CorreoPropietario" class="form-label">Correo del propietario</label>
                    <input asp-for="CorreoPropietario" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="CorreoPropietario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NumeroPropietario" class="form-label">Número del propietario</label>
                    <input asp-for="NumeroPropietario" class="form-control" placeholder="Ingrese el número de contacto" />
                    <span asp-validation-for="NumeroPropietario" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Registrar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
