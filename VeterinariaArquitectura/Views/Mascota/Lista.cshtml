@model IEnumerable<VeterinariaArquitectura.Models.Mascota>

@{
    ViewData["Title"] = "Mascotas";
}

<div class="container mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 page-heading">
        <div>
            <h1>Mascotas registradas</h1>
            <p>Consulta y administra la información de tus pacientes.</p>
        </div>
        <a asp-controller="Mascota" asp-action="RegistrarMascota" class="btn btn-primary">+ Nueva mascota</a>
    </div>

    @if (ViewData["Mensaje"] != null)
    {
        <div class="alert alert-info">
            @ViewData["Mensaje"]
        </div>
    }

    <div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Fecha de nacimiento</th>
                <th>Propietario</th>
                <th>Correo</th>
                <th>Número</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center">No hay mascotas registradas.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td>@item.NombrePropietario</td>
                        <td>@item.CorreoPropietario</td>
                        <td>@item.NumeroPropietario</td>
                        <td class="text-center">
                            <a asp-controller="Mascota" asp-action="Actualizar" asp-route-id="@item.MascotaId" class="btn btn-sm btn-warning">
                                Actualizar
                            </a>

                            <form asp-controller="Mascota" asp-action="Eliminar" asp-route-id="@item.MascotaId" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta mascota?');">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</div>
