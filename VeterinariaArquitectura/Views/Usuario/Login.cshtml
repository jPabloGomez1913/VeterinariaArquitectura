@model VeterinariaArquitectura.ViewModels.Usuario.LoginVM

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 class="text-center mb-4">Iniciar sesión</h2>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["Mensaje"]
                </div>
            }

            <form asp-action="Login" method="post" asp-controller="Usuario">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Clave" class="form-label"></label>
                    <input asp-for="Clave" type="password" class="form-control" placeholder="Ingrese su clave" />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Ingresar</button>

                <p class="text-center mt-3">
                    ¿No tienes cuenta? <a asp-controller="Usuario" asp-action="Registrarse">Regístrate aquí</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
