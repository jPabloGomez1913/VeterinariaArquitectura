@model VeterinariaArquitectura.ViewModels.Usuario.UsuarioVM

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 form-panel">
            <div class="page-heading text-center">
                <h1>Crear usuario</h1>
                <p>Registra la información del nuevo usuario.</p>
            </div>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="form-control" />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label asp-for="TipoDocumento" class="form-label">Tipo de documento</label>
                        <select asp-for="TipoDocumento" class="form-select">
                            <option value="0">Seleccione una opción</option>
                            <option value="1">Cédula de ciudadanía</option>
                            <option value="2">Cédula de extranjería</option>
                            <option value="3">Pasaporte</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-7 mb-3">
                        <label asp-for="NumeroDocumento" class="form-label">Número de documento</label>
                        <input asp-for="NumeroDocumento" class="form-control" />
                        <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Clave" class="form-label">Contraseña</label>
                        <input asp-for="Clave" class="form-control" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmarClave" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmarClave" class="form-control" />
                        <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Crear usuario</button>
                    <a asp-action="Lista" class="btn btn-secondary w-100">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
