@model VeterinariaArquitectura.ViewModels.Usuario.UsuarioVM

@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Crear cuenta</h2>

            <form asp-action="Registrarse" method="post" asp-controller="Usuario">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Ingrese su nombre completo" />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo documento</label>
                    <select asp-for="TipoDocumento" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="1">Cédula de Ciudadanía</option>
                        <option value="2">Cédula de Extranjería</option>
                        <option value="3">Tarjeta de Identidad</option>
                        <option value="4">Pasaporte</option>
                    </select>
                    <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Número documento</label>
                    <input asp-for="NumeroDocumento" class="form-control" placeholder="Número de documento" />
                    <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Clave" class="form-label"></label>
                    <input asp-for="Clave" type="password" class="form-control" placeholder="Ingrese su clave" />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar clave</label>
                    <input asp-for="ConfirmarClave" type="password" class="form-control" placeholder="Confirme su clave" />
                    <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Registrarse</button>

                @if(ViewData["Mensaje"] != null){
                    <div>
                        @ViewData["Mensaje"]
                    </div>
                }
                ¿Ya tienes una cuenta? <a asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
