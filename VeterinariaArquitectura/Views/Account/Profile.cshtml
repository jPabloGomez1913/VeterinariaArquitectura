@{
    ViewData["Title"] = "Mi perfil";
}

<div class="page-heading">
    <h1>@ViewData["Title"]</h1>
    <p>Información de tu cuenta.</p>
</div>
<section class="content-panel">
    <div class="row align-items-center g-4">
        <div class="col-auto">
            <img src="@User.FindFirst(c => c.Type == "picture")?.Value" alt="Foto de perfil" class="profile-photo rounded-circle" />
        </div>
        <div class="col">
            <h2 class="h4">@User.Identity.Name</h2>
            <p class="mb-1"><strong>Correo:</strong> @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</p>
            <p class="mb-1"><strong>Correo verificado:</strong> @User.FindFirst(c => c.Type == "email_verified")?.Value</p>
            <p class="mb-0"><strong>ID de usuario:</strong> @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</p>
        </div>
    </div>

    <h2 class="form-section-title">Datos de la cuenta</h2>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Tipo de dato</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in User.Claims)
                {
                    <tr>
                        <td>@claim.Type</td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>